@using PetShop.Components.Shared

@* ------------------------------------------------------------------
   ChatAvatar — avatar dùng chung cho mọi tin nhắn trong hộp thoại hợp nhất.

   Ba loại:
     - "ai"    ⇒ icon robot vector (SVG) — KHÔNG phụ thuộc file ảnh ngoài.
     - "user"  ⇒ ảnh thật từ Customer.avatar_url (data-URI hoặc http/https),
                  fallback chữ cái đầu tên trên nền cam.
     - "staff" ⇒ chữ cái đầu tên (bảng Staff/Admin/Doctor chưa có cột ảnh),
                  màu nền theo vai trò.

   Ảnh URL phải đi qua `ImageUrl.Safe` để KHÔNG bao giờ gán giá trị rác vào
   `src` (tránh 404 dồn dập khi re-render).
   ------------------------------------------------------------------ *@

<span class="chat-avatar chat-avatar--@Kind @RoleClass" style="@SizeStyle" aria-hidden="true">
    @if (Kind == "ai")
    {
        <svg class="chat-avatar__robot" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="7.5" width="16" height="11.5" rx="4"></rect>
            <circle cx="9.5" cy="13.2" r="1.3" fill="currentColor" stroke="none"></circle>
            <circle cx="14.5" cy="13.2" r="1.3" fill="currentColor" stroke="none"></circle>
            <path d="M12 7.5V4.6"></path>
            <circle cx="12" cy="3.4" r="1.4" fill="currentColor" stroke="none"></circle>
            <path d="M2.6 12.2v2.6M21.4 12.2v2.6"></path>
        </svg>
    }
    else if (!string.IsNullOrWhiteSpace(SafeAvatar))
    {
        <img class="chat-avatar__img" src="@SafeAvatar" alt="" loading="lazy" decoding="async" />
    }
    else
    {
        <span class="chat-avatar__initials">@Initials</span>
    }
</span>

@code {
    /// <summary>Loại avatar: "ai" / "user" / "staff".</summary>
    [Parameter]
    public string Kind { get; set; } = "user";

    /// <summary>Vai trò (chỉ dùng để đổi màu nền fallback initials).</summary>
    [Parameter]
    public string? Role { get; set; }

    /// <summary>Tên hiển thị — dùng để sinh chữ cái đầu.</summary>
    [Parameter]
    public string? Name { get; set; }

    /// <summary>Ảnh đại diện (data-URI hoặc http/https).</summary>
    [Parameter]
    public string? AvatarUrl { get; set; }

    /// <summary>Kích thước cạnh (px).</summary>
    [Parameter]
    public int Size { get; set; } = 34;

    /// <summary>URL ảnh đã qua bộ lọc an toàn (null nếu không dùng được).</summary>
    private string? SafeAvatar => ImageUrl.SafeOrNull(AvatarUrl);

    /// <summary>Class màu theo vai trò (chỉ nhân viên/bác sĩ mới có).</summary>
    private string RoleClass
    {
        get
        {
            var role = (Role ?? string.Empty).Trim().ToLowerInvariant();

            return role switch
            {
                "doctor" => "chat-avatar--doctor",
                "admin" => "chat-avatar--admin",
                _ => string.Empty
            };
        }
    }

    /// <summary>Style inline cho kích thước (để avatar nhỏ/lớn linh hoạt).</summary>
    private string SizeStyle => $"--chat-avatar-size: {Size}px;";

    /// <summary>Chữ cái đầu tên (tối đa 2 ký tự).</summary>
    private string Initials
    {
        get
        {
            var source = (Name ?? string.Empty).Trim();

            if (source.Length == 0)
            {
                return "?";
            }

            var parts = source.Split(' ', StringSplitOptions.RemoveEmptyEntries);

            if (parts.Length >= 2)
            {
                return string.Concat(
                    char.ToUpperInvariant(parts[0][0]),
                    char.ToUpperInvariant(parts[^1][0]));
            }

            return source[..Math.Min(2, source.Length)].ToUpperInvariant();
        }
    }
}
