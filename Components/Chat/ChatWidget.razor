@using PetShop.Models

@* ------------------------------------------------------------------
   ChatWidget — widget chat 1-1 khách ↔ nhân viên (Q21).

   Bổ sung MỚI theo quyết định của user (Q21 — "Có"), KHÔNG thay đổi
   markup / nội dung / màu của bất kỳ trang nào đã port.

   Giao diện:
     - Nút tròn nhỏ góc phải dưới (fixed) để mở/đóng khung chat.
     - Panel gồm: danh sách đối tác (dropdown) + khung tin nhắn
       (lịch sử + ô nhập + nút gửi).

   Dữ liệu: qua `IChatClient` (self-HTTP tới `api/chat/*`) — không inject
   DbContext trong component (3-layer).

   Realtime: SignalR tới `/hubs/notification` (dùng chung `NotificationHub`),
   join group `user:{userId}` để nhận event `ChatReceived`. Nếu kết nối
   realtime thất bại ⇒ vẫn gửi được tin qua HTTP fallback.
   ------------------------------------------------------------------ *@

@* Gốc widget luôn có mặt trong DOM (để layout fixed ổn định), nhưng phần
   nút mở chat + panel CHỈ hiển thị khi đã đăng nhập (UserSessionService). *@
<div class="@($"chat-widget{((IsVisible) ? string.Empty : " chat-widget--hidden")}")">
    @if (IsVisible)
    {
        @if (IsOpen)
        {
            <div class="chat-panel" role="dialog" aria-label="Hộp thoại chat">
                <div class="chat-panel-header">
                    <div class="chat-panel-title">
                        <span class="chat-panel-title-text">Trò chuyện</span>
                        @if (RealtimeConnected)
                        {
                            <span class="chat-panel-status" title="Đang kết nối realtime">● trực tuyến</span>
                        }
                        else
                        {
                            <span class="chat-panel-status chat-panel-status--offline" title="Không có realtime — vẫn gửi tin qua HTTP">● ngoại tuyến</span>
                        }
                    </div>
                    <button type="button" class="chat-panel-close" @onclick="TogglePanel" aria-label="Đóng chat">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                            <path d="M18 6L6 18M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>

                <div class="chat-peer-picker">
                    <label class="chat-peer-label" for="chat-peer-select">Đối tác</label>
                    <select id="chat-peer-select"
                            class="chat-peer-select"
                            value="@SelectedPeerId"
                            @onchange="OnPeerChangedAsync">
                        <option value="0">— Chọn người trò chuyện —</option>
                        @foreach (var peer in Peers)
                        {
                            <option value="@peer.PeerId">@peer.DisplayName (@peer.PeerRole)</option>
                        }
                    </select>
                </div>

                <div class="chat-messages" id="chatMessagesBox">
                    @if (Loading)
                    {
                        <div class="chat-empty">Đang tải…</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(Error))
                    {
                        <div class="chat-empty chat-empty--error">@Error</div>
                    }
                    else if (SelectedPeer is null)
                    {
                        <div class="chat-empty">Chọn một đối tác để bắt đầu trò chuyện.</div>
                    }
                    else if (Messages.Count == 0)
                    {
                        <div class="chat-empty">Chưa có tin nhắn nào với @SelectedPeer.DisplayName.</div>
                    }
                    else
                    {
                        @foreach (var message in Messages)
                        {
                            <div class="@($"chat-row {(message.IsMine ? "chat-row--mine" : "chat-row--theirs")}")">
                                <div class="chat-bubble">@message.Message</div>
                                <div class="chat-time">@FormatTime(message.CreatedAt)</div>
                            </div>
                        }
                    }
                </div>

                <div class="chat-composer">
                    <input type="text"
                           class="chat-input"
                           placeholder="@InputPlaceholder"
                           value="@Draft"
                           @oninput="OnInputChanged"
                           @onkeydown="OnKeyDownAsync"
                           disabled="@(SelectedPeer is null || Sending)" />
                    <button type="button"
                            class="chat-send-btn"
                            @onclick="SendAsync"
                            disabled="@(SelectedPeer is null || Sending || string.IsNullOrWhiteSpace(Draft))"
                            aria-label="Gửi tin nhắn">
                        @if (Sending)
                        {
                            <span>…</span>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M22 2L11 13"></path>
                                <path d="M22 2l-7 20-4-9-9-4 20-7z"></path>
                            </svg>
                        }
                    </button>
                </div>
            </div>
        }

        <button type="button"
                class="@($"chat-fab {(IsOpen ? "chat-fab--active" : string.Empty)}")"
                @onclick="TogglePanel"
                aria-label="Mở hộp thoại chat"
                title="Trò chuyện">
            @if (UnreadCount > 0)
            {
                <span class="chat-fab-badge">@(UnreadCount > 99 ? "99+" : UnreadCount.ToString())</span>
            }
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
        </button>
    }
</div>
