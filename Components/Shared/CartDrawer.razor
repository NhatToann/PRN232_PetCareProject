@using Microsoft.JSInterop;
@inject PetShop.Services.CartStateService CartState
@inject PetShop.Services.CartDrawerStateService DrawerState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<CartDrawer> Logger
@implements IDisposable

@* ------------------------------------------------------------------
   CART DRAWER — panel trượt bên phải.

   ⚠️ SỬA LỖI (11/11/2026) — "vừa vào web thì giỏ hàng tự hiện rồi tự mất":

   Nhánh cũ render `<div class="cart-drawer-root">` NGAY Ở render đầu tiên
   (khi `_isReady == false`) để hiện "Đang tải…". Nhưng CSS của
   `.cart-drawer-root` là:

       position: fixed; inset: 0; z-index: 10000;

   ⇒ một overlay PHỦ TOÀN MÀN HÌNH + panel trắng trượt vào từ phải xuất
   hiện ngay khi vừa vào web, rồi biến mất sau `OnAfterRenderAsync` ⇒
   người dùng thấy "trang cart tự hiện/tự mất".

   CÁCH SỬA: chỉ render drawer khi nó THẬT SỰ mở (`IsOpen`). Trạng thái
   "đang tải giỏ hàng" được xử lý bên trong panel, không hiện overlay.
   ------------------------------------------------------------------ *@
@if (IsOpen)
{
    <div class="cart-drawer-root" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title">
        <button type="button" class="cart-drawer-backdrop" aria-label="Đóng giỏ hàng" @onclick="CloseAsync"></button>
        <div class="cart-drawer">
            <header class="cart-drawer__header">
                <h2 id="cart-drawer-title" class="cart-drawer__title">Giỏ hàng</h2>
                <button type="button" class="cart-drawer__close" @onclick="CloseAsync" aria-label="Đóng">
                    <span class="cart-drawer__close-label">Đóng</span>
                    <span class="cart-drawer__close-icon" aria-hidden="true">×</span>
                </button>
            </header>

            <div class="cart-drawer__body">
                @if (!_isReady)
                {
                    <p style="padding:20px;text-align:center;color:#888;">Đang tải…</p>
                }
                else if (CartState.Items.Count == 0)
                {
                    <div class="cart-drawer__empty">
                        <p class="cart-drawer__empty-title">Giỏ hàng trống</p>
                        <p class="cart-drawer__empty-hint">Thêm sản phẩm để xem tại đây.</p>
                    </div>
                }
                else
                {
                    <ul class="cart-drawer__list">
                        @foreach (var item in CartState.Items)
                        {
                            <li class="cart-drawer__item" @key="item.ProductId">
                                <div class="cart-drawer__thumb">
                                    @if (!string.IsNullOrWhiteSpace(PetShop.Components.Shared.ImageUrl.SafeOrNull(item.ImageUrl)))
                                    {
                                        <img src="@PetShop.Components.Shared.ImageUrl.Safe(item.ImageUrl)" alt="" loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <span class="cart-drawer__thumb-placeholder" aria-hidden="true"></span>
                                    }
                                </div>
                                <div class="cart-drawer__item-main">
                                    <p class="cart-drawer__item-name">@item.Name</p>
                                    <p class="cart-drawer__item-meta">@item.Quantity × @FormatVnd(item.Price)</p>
                                </div>
                                <button type="button" class="cart-drawer__remove" @onclick="() => RemoveAsync(item.ProductId)" aria-label="Xóa @item.Name">×</button>
                            </li>
                        }
                    </ul>
                }
            </div>

            <footer class="cart-drawer__footer">
                <div class="cart-drawer__subtotal">
                    <span>Tạm tính</span>
                    <strong>@FormatVnd(CartState.Total)</strong>
                </div>
                <div class="cart-drawer__actions">
                    <button type="button" class="cart-drawer__btn cart-drawer__btn--secondary" @onclick="GoViewCartAsync">Xem giỏ hàng</button>
                    <button type="button" class="cart-drawer__btn cart-drawer__btn--primary" @onclick="GoCheckoutAsync" disabled="@(CartState.Items.Count == 0)">Thanh toán</button>
                </div>
            </footer>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Trạng thái mở/đóng do <see cref="CartDrawerStateService"/> quản lý.
    ///
    /// <para>
    /// Trước đây drawer nhận tham số <c>Open</c> từ page ⇒ mỗi page phải tự
    /// khai báo <c>cartDrawerOpen</c> + <c>OpenCart</c>/<c>CloseCart</c>, và chỉ 4
    /// page làm vậy ⇒ các trang khác bấm nút giỏ hàng **không phản hồi**.
    /// Nay đọc trạng thái từ service ⇒ hoạt động trên mọi trang.
    /// </para>
    /// </summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Drawer đang mở khi EITHER trang truyền <c>Open="true"</c> (cách cũ) HOẶC
    /// service báo mở (cách mới, dùng chung cho mọi trang).
    /// </summary>
    private bool IsOpen => Open || DrawerState.IsOpen;

    private bool _isReady;

    protected override void OnInitialized()
    {
        CartState.Changed += HandleCartChanged;
        DrawerState.Changed += HandleDrawerChanged;

        // QUAN TRỌNG — fix lỗi "nút giỏ hàng chết sau khi chuyển trang".
        //
        // VÌ SAO:
        //   Drawer là lớp overlay `position: fixed; inset: 0; z-index: 10000`
        //   (xem wwwroot/css/template/cartDrawer.css). Khi người dùng mở drawer
        //   rồi bấm link điều hướng (ví dụ menu "Dịch vụ", "Về chúng tôi"...),
        //   layout KHÔNG bị dispose ⇒ <CartDrawer> vẫn còn trong DOM và
        //   `DrawerState.IsOpen` vẫn = true ⇒ backdrop tiếp tục phủ kín màn hình.
        //
        //   ⇒ Mọi thao tác click của người dùng (kể cả nút giỏ hàng) bị backdrop
        //     nuốt mất ⇒ "bấm không có phản hồi" ⇒ buộc phải F5/reset trang.
        //
        // CÁCH SỬA:
        //   Mỗi lần route đổi ⇒ tự đóng drawer (đúng UX thông thường: điều hướng
        //   đi nơi khác thì panel trượt ra phải đóng lại).
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        DrawerState.Close();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isReady = true;
            try { await CartState.LoadAsync(); } catch (Exception ex) { Logger.LineWarning($"[CartDrawer.razor] CartState.LoadAsync threw: {ex.GetType().Name}"); }
            StateHasChanged();
        }
    }

    private Task CloseAsync()
    {
        DrawerState.Close();

        // Vẫn gọi OnClose nếu page cũ truyền (để giữ tương thích với các
        // page đang dùng <CartDrawer Open=... OnClose=... /> riêng).
        if (OnClose.HasDelegate)
        {
            return OnClose.InvokeAsync();
        }

        return Task.CompletedTask;
    }

    private async Task RemoveAsync(int productId) => await CartState.RemoveAsync(productId);

    private async Task GoViewCartAsync()
    {
        await CloseAsync();
        Navigation.NavigateTo("/cart");
    }

    private async Task GoCheckoutAsync()
    {
        if (CartState.Items.Count == 0)
        {
            return;
        }

        // Persist ALL cart items to sessionStorage — Checkout.razor reads this key.
        var checkoutItems = CartState.Items
            .Select(i => new CheckoutStorageItem(i.ProductId, i.Name, i.Price, i.ImageUrl, i.Quantity))
            .ToList();
        await JS.InvokeVoidAsync("sessionStorage.setItem", "checkoutItems", System.Text.Json.JsonSerializer.Serialize(checkoutItems));

        await CloseAsync();
        Navigation.NavigateTo("/cart/checkout");
    }

    private sealed record CheckoutStorageItem(int ProductId, string Name, decimal Price, string? ImageUrl, int Quantity);

    private static string FormatVnd(decimal value) => PetShop.Components.Shared.Format.Vnd(value);

    private void HandleCartChanged() { try { InvokeAsync(StateHasChanged); } catch (JSDisconnectedException) { } }

    private void HandleDrawerChanged() { try { InvokeAsync(StateHasChanged); } catch (JSDisconnectedException) { } }

    public void Dispose()
    {
        CartState.Changed -= HandleCartChanged;
        DrawerState.Changed -= HandleDrawerChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
