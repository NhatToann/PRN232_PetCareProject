@inject PetShop.Services.UserSessionService UserSession
@inject PetShop.Services.CartStateService CartState
@inject PetShop.Services.ShopContactService ShopContact
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<TopBar> Logger
@implements IDisposable

<div class="top-bar">
    <div class="container top-bar-container">
        <div class="top-bar-left">
            <span class="contact-item">
                <i class="fas fa-phone-alt icon" aria-hidden="true"></i>
                <span>@Hotline</span>
            </span>
            <span class="contact-item">
                <i class="fas fa-envelope icon" aria-hidden="true"></i>
                <span>@Email</span>
            </span>
        </div>

        <div class="top-bar-center" aria-hidden="true">
            <span class="top-bar-promo-badge">Giảm giá 15%</span>
            <span class="top-bar-promo-text">cho đơn hàng từ 1.000.000đ.</span>
        </div>

        <div class="top-bar-right">
            @if (UserSession.CurrentUser is not null)
            {
                <div class="top-bar-dropdown">
                    @if (IsStaffOrAdmin && UserSession.CurrentUser.UserId > 0)
                    {
                        <div class="top-bar-notif-slot">
                            <NotificationBell Variant="topbar" />
                        </div>
                    }

                    <button type="button" class="top-bar-link system-greeting-btn" @onclick="ToggleMenu">
                        <i class="fas fa-user icon" aria-hidden="true"></i>
                        @Greeting
                    </button>
                    
                    @if (openMenu)
                    {
                        <div class="top-bar-menu">
                            @if (Role == "admin")
                            {
                                <a href="/account" class="top-bar-menu-item" @onclick="CloseMenu">Quản lý tài khoản</a>
                                <a href="/system" class="top-bar-menu-item" @onclick="CloseMenu">Quản lý hệ thống</a>
                            }
                            else if (Role == "user")
                            {
                                <a href="/account" class="top-bar-menu-item" @onclick="CloseMenu">Quản lý tài khoản</a>
                                <a href="/account/orders" class="top-bar-menu-item" @onclick="CloseMenu">Lịch sử đơn hàng</a>
                                <a href="/spa-booking-history" class="top-bar-menu-item" @onclick="CloseMenu">Lịch sử đặt spa</a>
                            }
                            else if (Role == "staff")
                            {
                                <a href="/system" class="top-bar-menu-item" @onclick="CloseMenu">Quản lý hệ thống</a>
                            }

                            <button type="button" class="top-bar-menu-item" @onclick="LogoutAsync">Đăng xuất</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <a href="/login" class="top-bar-link">
                    <i class="fas fa-user icon" aria-hidden="true"></i>
                    Đăng nhập
                </a>
                <a href="/register" class="top-bar-link">Đăng ký</a>
            }
        </div>
    </div>
</div>

@code {
    private bool openMenu;

    /// <summary>
    /// Thông tin liên hệ THẬT (đọc từ bảng <c>SystemSettings</c>) — không hardcode.
    /// </summary>
    private string Hotline { get; set; } = string.Empty;

    private string Email { get; set; } = string.Empty;

    private string Role => (UserSession.CurrentUser?.Role ?? string.Empty).ToLowerInvariant();

    /// <summary>
    /// Vai trò nhân viên hoặc quản trị viên — nguồn chỉ hiện chuông thông báo cho 2 role này
    /// (điều kiện <c>authUser.role === 'staff' || authUser.role === 'admin'</c> trong TopBar.jsx).
    /// </summary>
    private bool IsStaffOrAdmin => Role is "staff" or "admin";

    private string Greeting
    {
        get
        {
            var label = Role switch
            {
                "admin" => "quản trị viên",
                "staff" => "nhân viên",
                "doctor" => "bác sĩ",
                "user" => "khách hàng",
                _ => "người dùng"
            };

            return $"Chào {label} {UserSession.CurrentUser?.Name}".Trim();
        }
    }

    protected override void OnInitialized()
    {
        UserSession.Changed += HandleSessionChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await UserSession.LoadAsync(); } catch (Exception ex) { Logger.LineWarning($"[TopBar] OnAfterRenderAsync LoadAsync threw: {ex.GetType().Name}"); }
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Nạp thông tin liên hệ thật từ SystemSettings (không hardcode).
        try
        {
            var contact = await ShopContact.GetAsync();
            Hotline = contact.Hotline;
            Email = contact.Email;
        }
        catch (Exception ex)
        {
            Logger.LineWarning($"[TopBar] Không nạp được thông tin liên hệ: {ex.GetType().Name}");
        }
    }

    private void ToggleMenu() => openMenu = !openMenu;

    private void CloseMenu() => openMenu = false;

    private async Task LogoutAsync()
    {
        await UserSession.SignOutAsync();
        await JS.InvokeVoidAsync("spaCart.clear");
        try { await CartState.ClearAsync(); } catch { /* localStorage write may fail in disconnected state */ }
        openMenu = false;

        // replace: true ⇒ không đẩy "/login" vào history.
        // Nếu không, bấm "Back" sau khi đăng xuất sẽ quay lại trang đã đăng nhập
        // và UserSessionService có thể khôi phục phiên cũ ⇒ cảm giác
        // "tự ý đăng nhập bằng tài khoản khác".
        Navigation.NavigateTo("/login", replace: true);
    }

    private void HandleSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        UserSession.Changed -= HandleSessionChanged;
    }
}
