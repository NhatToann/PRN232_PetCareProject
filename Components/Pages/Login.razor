@page "/login"
@layout PetShop_PRN222.Components.Layout.EmptyLayout
@inject PetShop.Interfaces.IAuthClient AuthClient
@inject PetShop.Services.UserSessionService UserSession
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Login> Logger

<PageTitle>Đăng nhập – Pet Toy Shop</PageTitle>

<div class="auth-page">

    <!-- Brand logo top-right -->
    <a href="/" class="brand-logo brand-logo--auth logo-home" aria-label="Pet Toy Shop">
        <div class="brand-logo__img">
            <img src="https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?w=160&q=80" alt="" width="56" height="56" decoding="async" />
        </div>
        <span class="brand-logo__text">Pet Toy Shop</span>
    </a>

    <!-- LEFT hero panel -->
    <div class="auth-left">
        <h2>Chào mừng trở lại</h2>
        <p>Vui lòng đăng nhập vào tài khoản của bạn</p>
    </div>

    <!-- RIGHT form panel -->
    <div class="auth-right">
        <h3>ĐĂNG NHẬP</h3>

        <form @onsubmit="HandleLoginAsync" @onsubmit:preventDefault>
            <input type="email"
                   name="email"
                   id="login-email"
                   placeholder="Email"
                   value="@email"
                   @oninput="e => email = e.Value?.ToString() ?? string.Empty"
                   required
                   disabled="@isBusy" />

            <input type="password"
                   name="password"
                   id="login-password"
                   placeholder="Mật khẩu"
                   value="@password"
                   @oninput="e => password = e.Value?.ToString() ?? string.Empty"
                   required
                   disabled="@isBusy" />

            <a href="/forgot-password" class="forgot">Quên mật khẩu?</a>

            <button type="submit" disabled="@isBusy">
                @(loginLoading ? "Đang đăng nhập..." : "Đăng nhập")
            </button>
        </form>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="auth-error">@error</div>
        }

        <!-- Google Login -->
        <button type="button" id="google-login-btn"
                class="google-login-btn"
                @onclick="HandleGoogleLoginAsync"
                disabled="@(isBusy || !googleReady)">
            <img src="https://developers.google.com/identity/images/g-logo.png" alt="google" />
            <span>@(loginLoading ? "Đang đăng nhập..." : "Đăng nhập với Google")</span>
        </button>

        <p>
            Chưa có tài khoản? <a href="/register">Đăng ký</a>
        </p>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private bool loginLoading;
    private bool googleReady;
    private bool gsiEnabled;
    private string? googleClientId;
    private string? error;

    // Fallback state (Authorization Code flow) — dùng khi GSI bị chặn do origin
    // chưa được đăng ký trong `javascript_origins` của OAuth client.
    private DotNetObjectReference<Login>? _googleCodeRef;
    private bool _usingGoogleFallback;

    private bool isBusy => loginLoading;

    /// <summary>
    /// Origin (scheme + host + port) của trang hiện tại.
    /// Lấy từ <see cref="NavigationManager.BaseUri"/> thay vì JS interop
    /// (JS interop không khả dụng trước khi circuit kết nối ⇒ gây lỗi).
    /// </summary>
    private string GetCurrentOrigin()
    {
        var baseUri = Navigation.BaseUri; // ví dụ: https://localhost:7083/
        return baseUri.TrimEnd('/');
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Quay lại từ Google OAuth (fallback flow) ⇒ xử lý token/error trước.
        await HandleOAuthReturnAsync();

        // Already logged in → redirect
        try { await UserSession.LoadAsync(); }
        catch (Exception ex) { Logger.LogWarning("[Login.razor] OnAfterRenderAsync LoadAsync threw: {ex.GetType().Name}", ex); }
        if (UserSession.IsAuthenticated)
        {
            Navigation.NavigateTo(UserSession.CurrentUser!.Role == "staff" ? "/system" : "/", replace: true);
            return;
        }

        // Fetch Google client ID and initialize GSI
        //
        // GSI (One Tap) chỉ chạy được ở origin nằm trong `javascript_origins` của
        // OAuth client. Nếu origin hiện tại không được đăng ký ⇒ gọi GSI chắc chắn
        // log 403 "The given origin is not allowed for the given client ID." ⇒ bỏ qua,
        // dùng luôn luồng Authorization Code flow.
        var origin = GetCurrentOrigin();
        var result = await AuthClient.GetGoogleClientInfoAsync(origin);
        if (result.IsSuccess && result.Data is not null && !string.IsNullOrWhiteSpace(result.Data.ClientId))
        {
            googleClientId = result.Data.ClientId;

            if (result.Data.GsiEnabled)
            {
                gsiEnabled = true;
                await InitGoogleAsync(googleClientId);
            }
            else
            {
                // Origin chưa được đăng ký ⇒ dùng thẳng Authorization Code flow.
                Logger.LogInformation(
                    "[Login.razor] Origin {Origin} chưa nằm trong javascript_origins ⇒ dùng Authorization Code flow.",
                    origin);
                googleReady = true;
                StateHasChanged();
            }
        }
    }

    private async Task InitGoogleAsync(string clientId)
    {
        try
        {
            _googleCodeRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("blazorAuth.initGoogle", clientId, DotNetObjectReference.Create(this));
            await JS.InvokeVoidAsync("blazorAuth.setCodeRef", _googleCodeRef);
            googleReady = true;
            StateHasChanged();
        }
        catch
        {
            // GSI may not be available (network). Not fatal.
        }
    }

    [JSInvokable]
    public async Task OnGoogleCredential(string idToken)
    {
        // Prevent double-invocation if Google fires the JS callback twice for
        // any reason (focus changes, popup lifecycle edge cases). The backend
        // does not have an idempotency token for the Google flow.
        if (loginLoading) return;

        error = null;
        loginLoading = true;
        StateHasChanged();

        var result = await AuthClient.GoogleLoginAsync(new PetShop.Models.GoogleLoginRequestDto(idToken, null));

        if (!result.IsSuccess || result.Data is null)
        {
            error = result.Error ?? "Đăng nhập Google thất bại.";
            loginLoading = false;
            StateHasChanged();
            return;
        }

        await UserSession.SignInAsync(result.Data);
        // No need to set loginLoading=false here — navigation tears down the component.
        Navigation.NavigateTo(result.Data.Role.Equals("staff", StringComparison.OrdinalIgnoreCase) ? "/system" : "/", replace: true);
    }

    /// <summary>
    /// GSI không mở popup được ⇒ origin hiện tại chưa được đăng ký trong
    /// <c>javascript_origins</c> của OAuth client. Chuyển sang Authorization Code flow
    /// (chỉ phụ thuộc <c>redirect_uris</c> ⇒ hoạt động từ mọi origin/port).
    /// </summary>
    [JSInvokable]
    public async Task OnGoogleFallbackNeeded()
    {
        if (loginLoading || _usingGoogleFallback) return;

        _usingGoogleFallback = true;
        error = null;

        try
        {
            var origin = GetCurrentOrigin();
            var urlResult = await AuthClient.GetGoogleAuthorizeUrlAsync(origin);
            if (!urlResult.IsSuccess || urlResult.Data is null)
            {
                error = urlResult.Error ?? "Không lấy được URL đăng nhập Google.";
                _usingGoogleFallback = false;
                StateHasChanged();
                return;
            }

            // Redirect toàn trang tới Google. Sau khi Google xác thực xong, server
            // redirect về lại /login của origin ban đầu kèm ?token=...
            Navigation.NavigateTo(urlResult.Data.AuthorizeUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogWarning("[Login.razor] OnGoogleFallbackNeeded failed: {Message}", ex.Message);
            error = "Google Login chưa sẵn sàng. Vui lòng thử lại.";
            _usingGoogleFallback = false;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Được gọi khi quay lại trang /login sau khi Google redirect.
    /// Đọc <c>?token=</c> (đăng nhập thành công) hoặc <c>?googleError=</c> (thất bại).
    /// </summary>
    private async Task HandleOAuthReturnAsync()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

            if (query.TryGetValue("token", out var tokenValues))
            {
                var token = tokenValues.ToString();
                if (!string.IsNullOrWhiteSpace(token))
                {
                    var result = await AuthClient.GoogleExchangeAsync(token);
                    if (result.IsSuccess && result.Data is not null)
                    {
                        await UserSession.SignInAsync(result.Data);
                        Navigation.NavigateTo(
                            result.Data.Role.Equals("staff", StringComparison.OrdinalIgnoreCase) ? "/system" : "/",
                            replace: true);
                        return;
                    }

                    error = result.Error ?? "Không hoàn tất được đăng nhập Google.";
                    return;
                }
            }

            if (query.TryGetValue("googleError", out var errorValues))
            {
                var errCode = errorValues.ToString();
                error = errCode switch
                {
                    "access_denied" => "Bạn đã từ chối quyền truy cập từ Google.",
                    "missing_code" => "Google không trả về mã đăng nhập.",
                    "invalid_state" => "Phiên đăng nhập Google không hợp lệ. Vui lòng thử lại.",
                    _ => "Đăng nhập Google thất bại."
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning("[Login.razor] HandleOAuthReturnAsync failed: {Message}", ex.Message);
            error = "Đăng nhập Google thất bại.";
        }
    }

    private async Task HandleLoginAsync()
    {
        // Single-click double-submit guard. The backend has no idempotency token yet,
        // so this client-side guard is critical for stable behaviour.
        if (loginLoading) return;

        error = null;
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            error = "Vui lòng nhập Email và mật khẩu.";
            return;
        }

        loginLoading = true;
        StateHasChanged();
        try
        {
            var result = await AuthClient.LoginAsync(new PetShop.Models.LoginRequestDto(email.Trim(), password));

            if (!result.IsSuccess || result.Data is null)
            {
                error = result.Error ?? "Đăng nhập thất bại.";
                return;
            }

            await UserSession.SignInAsync(result.Data);
            Navigation.NavigateTo(result.Data.Role.Equals("staff", StringComparison.OrdinalIgnoreCase) ? "/system" : "/", replace: true);
        }
        finally
        {
            loginLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleGoogleLoginAsync()
    {
        if (!googleReady) return;
        error = null;
        try
        {
            if (gsiEnabled)
            {
                await JS.InvokeVoidAsync("blazorAuth.promptGoogle");
            }
            else
            {
                // Origin chưa được đăng ký trong `javascript_origins` ⇒ GSI không dùng
                // được ⇒ chuyển thẳng sang luồng Authorization Code flow.
                await OnGoogleFallbackNeeded();
            }
        }
        catch
        {
            error = "Google Login chưa sẵn sàng. Vui lòng thử lại.";
        }
    }
}
