@page "/contact"

@inject PetShop.Services.ShopContactService ShopContact

<PageTitle>Liên hệ</PageTitle>

<div class="home-page about-page">
    <PageStyles CssFiles="@PetShop.Services.CssBundle.About" />
<TopBar />
    <Header />
    <Navigation />

    <main class="about-main">
        <section class="about-hero">
            <div class="container">
                <div class="about-hero__card">
                    <p class="about-hero__kicker">Liên hệ</p>
                    <h1>Liên hệ với Pet Toy Shop</h1>
                    <p>
                        Bạn cần tư vấn nhanh, đặt dịch vụ spa hay tìm sản phẩm phù hợp cho thú cưng?
                        Pet Toy Shop luôn sẵn sàng đồng hành cùng bạn.
                    </p>
                </div>
            </div>
        </section>

        <section class="about-section">
            <div class="container">
                <div class="about-grid about-grid--two">
                    <article class="about-card">
                        <h2>Thông tin liên hệ</h2>
                        <ul class="about-contact__list">
                            <li>
                                <i class="fas fa-map-marker-alt contact-icon" aria-hidden="true"></i>
                                <span>@Address</span>
                            </li>
                            <li>
                                <i class="fas fa-phone contact-icon" aria-hidden="true"></i>
                                <span>@Hotline</span>
                            </li>
                            <li>
                                <i class="fas fa-envelope contact-icon" aria-hidden="true"></i>
                                <span>@Email</span>
                            </li>
                            <li>
                                <i class="fas fa-clock contact-icon" aria-hidden="true"></i>
                                <span>@WorkingHours</span>
                            </li>
                        </ul>
                    </article>

                    <article class="about-card">
                        <h2>Về chúng tôi</h2>
                        <p>
                            Thế giới đồ chơi cho thú cưng với hơn 1000+ sản phẩm chất lượng, an toàn và thân thiện với mọi loài vật.
                        </p>
                    </article>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</div>

@code {
    /// <summary>
    /// Thông tin liên hệ THẬT (đọc từ bảng <c>SystemSettings</c>) — không hardcode.
    /// </summary>
    private string Address { get; set; } = string.Empty;

    private string Hotline { get; set; } = string.Empty;

    private string Email { get; set; } = string.Empty;

    private string WorkingHours { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contact = await ShopContact.GetAsync();
            Address = contact.Address;
            Hotline = contact.Hotline;
            Email = contact.Email;
            WorkingHours = contact.WorkingHours;
        }
        catch
        {
            // DB lỗi ⇒ để trống, không crash trang.
        }
    }
}
