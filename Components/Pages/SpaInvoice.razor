@page "/spa-invoice"
@inject ISpaBookingClient SpaClient
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<SpaInvoice> Logger
@implements IDisposable

<PageTitle>Hóa đơn spa – Pet Toy Shop</PageTitle>

<div class="home-page spa-invoice-page">
    <PageStyles CssFiles="@PetShop.Services.CssBundle.SpaInvoice" />
<TopBar />
    <PageContextBar Title="Hóa đơn" />

    <RouteGuard AllowedRoles="customer">
    <main class="spa-invoice-page__main">

        @* ===== LOADING ===== *@
        @if (isLoading)
        {
            <div class="spa-invoice__loading">
                <div class="spa-invoice__spinner"></div>
                <p>Đang tải hóa đơn...</p>
            </div>
        }

        @* ===== ERROR ===== *@
        else if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="spa-invoice__error-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="1.5">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                <p>@error</p>
                <a class="spa-invoice-btn spa-invoice-btn--outline" href="/spa-booking-history">
                    Quay lại lịch sử
                </a>
            </div>
        }

        @* ===== MISSING bookingId ===== *@
        else if (BookingId is null || BookingId <= 0)
        {
            <div class="spa-invoice__error-state">
                <p>Thiếu mã booking.</p>
                <a class="spa-invoice-btn spa-invoice-btn--outline" href="/spa-booking-history">
                    Quay lại lịch sử
                </a>
            </div>
        }

        @* ===== INVOICE CARD ===== *@
        else if (invoice is not null)
        {
            var payosSuccess = string.Equals(Payos, "success", StringComparison.OrdinalIgnoreCase);
            var payosCancel  = string.Equals(Payos, "cancel",  StringComparison.OrdinalIgnoreCase);
            var statusLabel  = GetStatusLabel(invoice.Status ?? "", payosSuccess, payosCancel);
            var statusClass  = GetStatusClass(payosSuccess, payosCancel);
            var createdDate   = invoice.CreatedAt.HasValue ? invoice.CreatedAt.Value.ToString("dd/MM/yyyy") : "-";
            var apptDate     = invoice.AppointmentStart.ToString("dd/MM/yyyy");
            var apptTime     = invoice.AppointmentStart.ToString("HH:mm");
            var subtotal     = invoice.Items.Sum(i => i.UnitPrice * i.Quantity);
            var displayTotal = invoice.TotalPrice > 0 ? invoice.TotalPrice : subtotal;

            // VAT ĐÃ BAO GỒM trong giá dịch vụ.
            //
            // Số tiền khách trả qua PayOS = tổng giá dịch vụ (không cộng VAT ở
            // phía server — xem PayOSController.CreateSpaPayment). Trước đây trang
            // này CỘNG thêm 10% ở client ⇒ "Tổng cộng" hiển thị KHÔNG KHỚP với
            // số tiền thực thanh toán ⇒ người dùng tưởng bị tính sai.
            //
            // Nay: VAT hiển thị là phần VAT đã nằm trong giá (10/110 của tổng),
            // và TỔNG CỘNG = đúng số tiền đã thanh toán.
            var vat          = (long)Math.Round(displayTotal * 0.1m / 1.1m);
            var grandTotal   = displayTotal;

            <article class="spa-invoice-card @(payosCancel ? "spa-invoice-card--cancel" : "")">

                @* ---- Header: brand + meta + status badge ---- *@
                <div class="spa-invoice-card__header">
                    <div class="spa-invoice-card__header-left">

                        @* Brand *@
                        <div class="spa-invoice-card__brand">
                            <div class="spa-invoice-card__brand-icon">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 2a5 5 0 0 1 5 5c0 2.76-2.24 5-5 5s-5-2.24-5-5a5 5 0 0 1 5-5z"/>
                                    <path d="M12 22v-7"/>
                                    <path d="M8 17l4-5 4 5"/>
                                </svg>
                            </div>
                            <div>
                                <span class="spa-invoice-card__brand-name">Pet Toy Shop</span>
                                <span class="spa-invoice-card__brand-sub">Pet Spa Service</span>
                            </div>
                        </div>

                        @* Meta *@
                        <div class="spa-invoice-card__meta">
                            <div class="spa-invoice-card__meta-item">
                                <span class="spa-invoice-card__meta-label">Ngày đặt</span>
                                <span class="spa-invoice-card__meta-value">@createdDate</span>
                            </div>
                            <div class="spa-invoice-card__meta-item">
                                <span class="spa-invoice-card__meta-label">Mã booking</span>
                                <span class="spa-invoice-card__booking-id">#@invoice.BookingId</span>
                            </div>
                        </div>
                    </div>

                    @* Status badge *@
                    <div class="spa-invoice-card__status-badge @statusClass">
                        <span class="spa-invoice-card__status-dot"></span>
                        <span>@statusLabel</span>
                    </div>
                </div>

                @* ---- Cancel alert ---- *@
                @if (payosCancel)
                {
                    <div class="spa-invoice-card__alert">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="15" y1="9" x2="9" y2="15"/>
                            <line x1="9" y1="9" x2="15" y2="15"/>
                        </svg>
                        Đơn thanh toán đã bị hủy. Bạn có thể đặt lịch lại bất kỳ lúc nào.
                    </div>
                }

                @* ---- Info grid: 2 columns ---- *@
                <div class="spa-invoice-card__info-grid">

                    @* Left: Customer info *@
                    <div class="spa-invoice-card__info-section">
                        <h3 class="spa-invoice-card__section-title">Thông tin khách hàng</h3>
                        <div class="spa-invoice-card__info-table">
                            <div class="spa-invoice-card__info-row">
                                <span>Khách hàng</span>
                                <strong>@(invoice.CustomerName ?? "-")</strong>
                            </div>
                            <div class="spa-invoice-card__info-row">
                                <span>Email</span>
                                <strong>@(invoice.CustomerEmail ?? "-")</strong>
                            </div>
                            <div class="spa-invoice-card__info-row">
                                <span>Thú cưng</span>
                                <strong>@(invoice.PetName ?? "-")</strong>
                            </div>
                        </div>
                    </div>

                    @* Right: Appointment info *@
                    <div class="spa-invoice-card__info-section">
                        <h3 class="spa-invoice-card__section-title">Thông tin đặt lịch</h3>
                        <div class="spa-invoice-card__info-table">
                            <div class="spa-invoice-card__info-row">
                                <span>Ngày hẹn</span>
                                <strong>@apptDate</strong>
                            </div>
                            <div class="spa-invoice-card__info-row">
                                <span>Giờ bắt đầu</span>
                                <strong>@apptTime</strong>
                            </div>
                            <div class="spa-invoice-card__info-row">
                                <span>Trạng thái</span>
                                <strong>@statusLabel</strong>
                            </div>
                        </div>
                    </div>
                </div>

                @* ---- Service table ---- *@
                <div class="spa-invoice-card__services">
                    <h3 class="spa-invoice-card__section-title">Chi tiết dịch vụ</h3>
                    <div class="spa-invoice-card__table">
                        <div class="spa-invoice-card__table-head">
                            <span>STT</span>
                            <span>Tên dịch vụ</span>
                            <span>Đơn giá</span>
                            <span>Thành tiền</span>
                        </div>
                        @for (int i = 0; i < invoice.Items.Count; i++)
                        {
                            var item = invoice.Items[i];
                            var lineTotal = item.UnitPrice * item.Quantity;
                            <div class="spa-invoice-card__table-row">
                                <span>@(i + 1)</span>
                                <span class="spa-invoice-card__service-name">@item.ServiceName</span>
                                <span>@PetShop.Components.Shared.Format.Vnd(item.UnitPrice)</span>
                                <strong>@PetShop.Components.Shared.Format.Vnd(lineTotal)</strong>
                            </div>
                        }
                    </div>
                </div>

                @* ---- Totals ---- *@
                <div class="spa-invoice-card__totals">
                    <div class="spa-invoice-card__total-row spa-invoice-card__total-row--muted">
                        <span>Tạm tính</span>
                        <span>@PetShop.Components.Shared.Format.Vnd(displayTotal)</span>
                    </div>
                    <div class="spa-invoice-card__total-row spa-invoice-card__total-row--muted">
                        <span>VAT (10%, đã bao gồm)</span>
                        <span>@PetShop.Components.Shared.Format.Vnd(vat)</span>
                    </div>
                    <div class="spa-invoice-card__grand-total">
                        <span>Tổng cộng</span>
                        <strong>@PetShop.Components.Shared.Format.Vnd(grandTotal)</strong>
                    </div>
                </div>

                @* ---- Footer: thanks + action buttons ---- *@
                <div class="spa-invoice-card__footer">
                    @if (!payosCancel)
                    {
                        <p class="spa-invoice-card__thanks">
                            Cảm ơn quý khách đã sử dụng dịch vụ của Pet Toy Shop!
                        </p>
                    }
                    <div class="spa-invoice-card__actions">
                        @if (payosCancel)
                        {
                            <a class="spa-invoice-btn spa-invoice-btn--outline" href="/spa-cart">
                                Quay lại giỏ spa
                            </a>
                        }
                        else
                        {
                            <a class="spa-invoice-btn spa-invoice-btn--outline" href="/spa-booking-history">
                                Xem lịch sử booking
                            </a>
                        }
                        <button type="button" class="spa-invoice-btn spa-invoice-btn--primary" @onclick="PrintInvoice">
                            In hóa đơn
                        </button>
                    </div>
                </div>
            </article>
        }

    </main>

    <Footer />
    </RouteGuard>
</div>

@code {
    [SupplyParameterFromQuery(Name = "bookingId")] private int? BookingId { get; set; }
    [SupplyParameterFromQuery(Name = "payos")]  private string? Payos { get; set; }
    [SupplyParameterFromQuery(Name = "orderCode")] private int? OrderCode { get; set; }

    private SpaBookingInvoiceDto? invoice;
    private bool isLoading = true;
    private string? error;
    private bool _statusSynced;

    /// <summary>
    /// Nhãn trạng thái hiển thị trên hóa đơn.
    ///
    /// <para>
    /// <b>KHÔNG</b> dùng query param <c>?payos=success</c> để kết luận "đã thanh toán":
    /// tham số này do client kiểm soát, ai cũng gõ được vào URL. Chỉ khi
    /// <c>payos=cancel</c> mới dùng (vì hủy không làm thay đổi tiền).
    /// Trạng thái "đã thanh toán" phải đến từ DB sau khi server đã hỏi PayOS
    /// và xác minh (xem <c>ReloadAsync</c> → <c>SyncPaymentAsync</c>).
    /// </para>
    /// </summary>
    private string GetStatusLabel(string dbStatus, bool payosSuccess, bool payosCancel)
    {
        if (payosCancel) return SpaBookingStatus.Cancelled;

        var normalized = (dbStatus ?? string.Empty).Trim();
        if (normalized.Equals(SpaBookingStatus.Paid, StringComparison.OrdinalIgnoreCase)
            || normalized.Contains("thanh toán", StringComparison.OrdinalIgnoreCase))
        {
            return SpaBookingStatus.Paid;
        }

        // Nếu PayOS báo thành công nhưng webhook chưa tới, server đã hỏi trực tiếp
        // rồi ⇒ DB sẽ có "Đã thanh toán". Nếu vẫn chưa, hiển thị trạng thái DB.
        return string.IsNullOrWhiteSpace(normalized) ? "Chưa thanh toán" : normalized;
    }

    private string GetStatusClass(bool payosSuccess, bool payosCancel)
    {
        if (payosCancel)  return "is-cancel";
        if (payosSuccess) return "is-paid";
        return "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await UserSession.LoadAsync(); }
        catch (Exception ex)
        {
            Logger.LineWarning($"[SpaInvoice] UserSession.LoadAsync: {ex.Message}");
        }
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        error = null;
        StateHasChanged();

        if (CurrentCustomerId <= 0)
        {
            error = "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại để xem hóa đơn.";
            isLoading = false;
            StateHasChanged();
            return;
        }

        // THIẾU MÃ BOOKING: khách đã thanh toán PayOS nhưng URL redirect bị mất
        // query string ⇒ không có bookingId. Khôi phục theo thứ tự:
        //   1. localStorage (dự phòng — luôn đúng vì do chính app ghi)
        //   2. orderCode PayOS trên URL (dự phòng thứ hai)
        //   3. booking spa đang thanh toán gần nhất trên server (dự phòng thứ ba)
        var restoredFromStorage = false;
        if (BookingId is null or <= 0)
        {
            var restored = await TryRestoreBookingIdFromLocalStorageAsync();
            restoredFromStorage = restored is not null;
            restored ??= await TryRestoreBookingIdFromOrderCodeAsync();
            restored ??= await TryRestoreBookingIdFromLatestPayOSAsync();
            if (restored is null)
            {
                error = "Thiếu mã booking. Vui lòng mở lại từ lịch sử đặt lịch spa.";
                isLoading = false;
                StateHasChanged();
                return;
            }

            // Gán lại để phần render hiển thị "Mã booking" đúng giá trị.
            BookingId = restored;
        }

        var effectiveBookingId = BookingId!.Value;

        // Đồng bộ trạng thái thanh toán từ PayOS (SERVER xác minh).
        //
        // Trước đây trang này tự PATCH status theo query param `?payos=success`
        // — nhưng endpoint đó yêu cầu policy StaffOrAdmin ⇒ khách hàng luôn 403
        // ⇒ luồng đặt spa không hoạt động. Nay server tự tra payment trong DB
        // và hỏi PayOS trực tiếp ⇒ không thể giả mạo trạng thái thanh toán.
        //
        // Điều kiện gọi: có `?payos=...` trên URL HOẶC vừa khôi phục booking từ
        // localStorage (trường hợp URL bị rút gọn mất toàn bộ query string).
        // Nếu không gọi, webhook PayOS (gửi về localhost ⇒ không tới được) sẽ
        // khiến booking mãi ở trạng thái "Chờ thanh toán PayOS" dù khách đã trả.
        if (!_statusSynced && (!string.IsNullOrWhiteSpace(Payos) || restoredFromStorage))
        {
            _statusSynced = true;

            var syncResult = await SpaClient.SyncPaymentAsync(effectiveBookingId, CurrentCustomerId);
            if (!syncResult.IsSuccess)
            {
                Logger.LineWarning($"[SpaInvoice] SyncPaymentAsync thất bại: {syncResult.Error}");
            }
        }

        // Fetch invoice
        var res = await SpaClient.GetInvoiceAsync(effectiveBookingId, CurrentCustomerId);
        if (!res.IsSuccess || res.Data is null)
        {
            error = res.StatusCode == 404
                ? "Không tìm thấy hóa đơn."
                : (res.Error ?? "Không tải được hóa đơn.");
        }
        else
        {
            invoice = res.Data;

            // Đã hiển thị xong hóa đơn ⇒ xoá bản ghi dự phòng trong localStorage
            // để lần sau không khôi phục nhầm booking cũ.
            try
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", SpaCart.PendingSpaBookingKey);
            }
            catch (Exception ex)
            {
                Logger.LineWarning($"[SpaInvoice] Không xoá được localStorage spa: {ex.Message}");
            }
        }

        isLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Khôi phục mã booking từ <c>localStorage</c>.
    ///
    /// <para>
    /// Trước khi rời trang để sang PayOS, <c>SpaCart</c> lưu booking đang thanh
    /// toán vào <c>localStorage</c> (key <c>pendingSpaBooking</c>). Nhờ vậy, kể cả
    /// khi PayOS redirect về mà query string bị rút gọn, trang hóa đơn vẫn biết
    /// chính xác booking nào cần hiển thị — không phụ thuộc URL.
    /// </para>
    /// </summary>
    private async Task<int?> TryRestoreBookingIdFromLocalStorageAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", SpaCart.PendingSpaBookingKey);
            if (string.IsNullOrWhiteSpace(raw))
            {
                return null;
            }

            var pending = System.Text.Json.JsonSerializer.Deserialize<SpaCart.PendingSpaBooking>(
                raw, SpaCart.PendingSpaBookingJsonOptions);
            if (pending is null || pending.BookingId <= 0)
            {
                return null;
            }

            Logger.Line($"[SpaInvoice] Đã khôi phục booking #{pending.BookingId} từ localStorage.");
            return pending.BookingId;
        }
        catch (Exception ex)
        {
            Logger.LineWarning($"[SpaInvoice] Không đọc được localStorage spa: {ex.Message}");
            return null;
        }
    }

    /// <summary>
    /// Khôi phục mã booking từ mã đơn PayOS (<c>orderCode</c>) khi URL redirect
    /// về trang hóa đơn không mang theo <c>bookingId</c>.
    /// </summary>
    private async Task<int?> TryRestoreBookingIdFromOrderCodeAsync()
    {
        if (OrderCode is null or <= 0)
        {
            return null;
        }

        var res = await SpaClient.GetByOrderCodeAsync(OrderCode.Value, CurrentCustomerId);
        if (!res.IsSuccess || res.Data is null)
        {
            Logger.LineWarning($"[SpaInvoice] Không khôi phục được booking từ orderCode={OrderCode}: {res.Error}");
            return null;
        }

        Logger.Line($"[SpaInvoice] Đã khôi phục booking #{res.Data.BookingId} từ orderCode={OrderCode}");
        return res.Data.BookingId;
    }

    /// <summary>
    /// Khôi phục mã booking từ server — booking spa đang thanh toán PayOS gần nhất
    /// của chính khách đang đăng nhập.
    ///
    /// <para>
    /// Lớp dự phòng CUỐI CÙNG: dùng khi URL không còn query string VÀ localStorage
    /// đã bị xoá (vd người dùng mở tab mới, hoặc trình duyệt chặn storage).
    /// Server tự tra trong bảng <c>Payments</c> và chỉ trả booking của chính khách
    /// (kiểm tra claim) ⇒ không lộ thông tin người khác.
    /// </para>
    /// </summary>
    private async Task<int?> TryRestoreBookingIdFromLatestPayOSAsync()
    {
        if (CurrentCustomerId <= 0)
        {
            return null;
        }

        try
        {
            var res = await SpaClient.GetLatestPayOSBookingAsync(CurrentCustomerId);
            if (!res.IsSuccess || res.Data is null)
            {
                return null;
            }

            Logger.Line($"[SpaInvoice] Đã khôi phục booking #{res.Data.BookingId} từ payment gần nhất.");
            return res.Data.BookingId;
        }
        catch (Exception ex)
        {
            Logger.LineWarning($"[SpaInvoice] Không khôi phục được booking từ server: {ex.Message}");
            return null;
        }
    }

    protected override void OnInitialized()
    {
        UserSession.Changed += HandleSessionChanged;
    }

    private void HandleSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        UserSession.Changed -= HandleSessionChanged;
    }

    private int CurrentCustomerId => UserSession.CurrentUser?.UserId ?? 0;

    private async Task PrintInvoice() => await JS.InvokeVoidAsync("window.print");
}
