@inherits LayoutComponentBase
@inject PetShop.Services.CartStateService CartState
@inject IJSRuntime JS

<div class="chatbot-layout @(isChatOpen ? "chatbot-open" : string.Empty)">
    <div class="chatbot-layout-content">
        @Body
    </div>
    <ChatbotWidget IsOpen="@isChatOpen" IsOpenChanged="HandleChatOpenChanged" />
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">x</a>
</div>

@code {
    private bool _cartInitialized;
    private bool isChatOpen;

    private void HandleChatOpenChanged(bool open) => isChatOpen = open;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_cartInitialized)
        {
            _cartInitialized = true;
            CartState.AttachRuntime(JS);
            try { await CartState.LoadAsync(); }
            catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[MainLayout.razor] CartState.LoadAsync threw: {ex.GetType().Name}"); }
        }
    }
}
