@inherits LayoutComponentBase
@inject PetShop.Services.CartStateService CartState
@inject IJSRuntime JS
@inject ILogger<MainLayout> Logger

@Body

@* Q21 — widget chat 1-1 khách ↔ nhân viên (fixed, góc phải dưới).
   Bổ sung MỚI theo quyết định của user; không thay đổi markup của trang nào. *@
<ChatWidget />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">x</a>
</div>

@code {
    private bool _cartInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_cartInitialized)
        {
            _cartInitialized = true;
            CartState.AttachRuntime(JS);
            try { await CartState.LoadAsync(); }
            catch (Exception ex) { Logger.LineWarning($"[MainLayout.razor] CartState.LoadAsync threw: {ex.GetType().Name}"); }
        }
    }
}
