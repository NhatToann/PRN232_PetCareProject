@code {
    private string staffName = "Phan Gia Hưng";
    private string staffInitials = "PH";
    private string currentMenu = "Bảng điều khiển";
    private int countdown = 30;

    // Dùng System.Threading.Timer (thread pool) thay vì Timer của ASP.NET Core.
    // LƯU Ý: timer của ASP.NET Core KHÔNG được dùng cho việc lặp vô hạn —
    // nó sẽ bị gom cùng một CancellationToken với request, nên timer bị hủy
    // khi request kết thúc ⇒ nhảy về 30 s liên tục. Đây là một nguyên nhân
    // của việc "làm mới" không bao giờ chạy đúng nhịp.
    private System.Threading.Timer? _timer;

    // Handler đã đăng ký để có thể hủy đúng khi Dispose.
    // Bản cũ dùng lambda không lưu tham chiếu ⇒ `Navigation.LocationChanged -= (s, e) => { }`
    // KHÔNG hủy được handler thật ⇒ mỗi lần vào workspace lại leak một handler.
    private EventHandler<LocationChangedEventArgs>? _locationChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        EventHandler<LocationChangedEventArgs> handler = (_, e) =>
        {
            UpdateBreadcrumb(e.Location);
            _ = InvokeAsync(StateHasChanged);
        };
        _locationChangedHandler = handler;

        UpdateBreadcrumb(Navigation.Uri);
        Navigation.LocationChanged += handler;

        _timer = new System.Threading.Timer(
            _ => TickCountdown(),
            null,
            TimeSpan.Zero,
            TimeSpan.FromSeconds(1));

        try
        {
            // Lấy đúng người đang đăng nhập (theo email trong session) thay vì id cố định.
            var user = UserSession.CurrentUser;
            if (user is not null)
            {
                var profile = await ProfileService.GetProfileAsync(user.UserId, user.Email);
                if (profile is not null && !string.IsNullOrWhiteSpace(profile.Name))
                {
                    staffName = profile.Name;
                    staffInitials = BuildInitials(staffName);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LineWarning($"[StaffWorkspaceLayout] Không tải được tên nhân viên: {ex.GetType().Name}");
        }
    }

    private void TickCountdown()
    {
        countdown--;
        if (countdown <= 0)
        {
            countdown = 30;

            // Đồng hồ này trước đây CHỈ đếm ngược rồi về 30 mà không làm gì cả
            // ⇒ là một thông số giả gây hiểu nhầm. Nay nó phát tín hiệu thật để
            // các trang staff đang mở nạp lại dữ liệu từ DB.
            try
            {
                RefreshSignal.RequestRefresh();
            }
            catch (Exception ex)
            {
                Logger.LineWarning($"[StaffWorkspaceLayout] Phát tín hiệu làm mới lỗi: {ex.GetType().Name}");
            }
        }

        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Đăng xuất thật sự: xoá session khỏi ProtectedLocalStorage + giỏ hàng,
    /// rồi chuyển về /login (replace: true để giữ circuit, không reload trang).
    /// </summary>
    private async Task LogoutAsync()
    {
        try
        {
            await UserSession.SignOutAsync();
            await CartState.ClearAsync();
        }
        catch (Exception ex)
        {
            Logger.LineWarning($"[StaffWorkspaceLayout] LogoutAsync: {ex.GetType().Name}");
        }

        Navigation.NavigateTo("/login", replace: true);
    }

    private static string BuildInitials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "NV";
        }

        if (parts.Length == 1)
        {
            return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        }

        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpper();
    }

    private void UpdateBreadcrumb(string url)
    {
        if (url.Contains("/revenue")) currentMenu = "Báo cáo doanh thu";
        else if (url.Contains("/system/orders")) currentMenu = "Quản lý đơn hàng";
        else if (url.Contains("/system/bookings")) currentMenu = "Lịch hẹn Spa";
        else if (url.Contains("/products/list")) currentMenu = "Danh sách sản phẩm";
        else if (url.Contains("/products/inventory")) currentMenu = "Quản lý tồn kho";
        else if (url.Contains("/system/schedule")) currentMenu = "Lịch trực cá nhân";
        else if (url.Contains("/system/profile")) currentMenu = "Hồ sơ của tôi";
        else currentMenu = "Bảng điều khiển";
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;

        if (_locationChangedHandler is not null)
        {
            Navigation.LocationChanged -= _locationChangedHandler;
            _locationChangedHandler = null;
        }
    }
}