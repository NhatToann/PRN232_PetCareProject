        }

        .menu-item:hover i, .menu-item.active i {
            color: var(--fox-purple);
        }

    .fox-main {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .fox-topbar {
        height: 75px;
