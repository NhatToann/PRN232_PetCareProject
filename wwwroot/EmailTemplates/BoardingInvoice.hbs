<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <title>Xac nhan dat phong boarding</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f7f7f7;
      padding: 24px;
    }
    .card {
      max-width: 640px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }
    h1 {
      margin: 0 0 8px;
      color: #2b2b2b;
    }
    .subtitle {
      color: #666;
      margin-bottom: 24px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      padding: 10px 8px;
      border-bottom: 1px solid #eee;
      text-align: left;
      font-size: 14px;
    }
    th {
      background: #fafafa;
    }
    .total {
      text-align: right;
      font-size: 16px;
      font-weight: 700;
      margin-top: 16px;
    }
    .payment-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 700;
    }
    .payment-badge--paid {
      background: #eafaf1;
      color: #1a7a4a;
    }
    .payment-badge--unpaid {
      background: #fdf0ef;
      color: #c0392b;
    }
    .footer {
      margin-top: 24px;
      font-size: 13px;
      color: #888;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>Xac nhan dat phong boarding</h1>
    <div class="subtitle">Xin chao {{CustomerName}}, cam on ban da dat phong tai PetShop.</div>

    <p><strong>Ma booking:</strong> {{BookingCode}}</p>
    <p><strong>Phong:</strong> {{RoomDisplay}}</p>
    <p>
      <strong>Thoi gian:</strong>
      {{CheckIn}} &rarr; {{CheckOut}} ({{Days}} ngay)
    </p>
    <p><strong>So thu cung:</strong> {{Pets}}</p>

    @if (!string.IsNullOrWhiteSpace(Notes))
    {
      <p><strong>Ghi chu:</strong> {{Notes}}</p>
    }

    <table>
      <thead>
        <tr>
          <th>Hang muc</th>
          <th>Don gia</th>
          <th>Thanh tien</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Phong boarding x {{Days}} ngay</td>
          <td>{{PricePerDay}} đ</td>
          <td>{{TotalPrice}} đ</td>
        </tr>
      </tbody>
    </table>

    <div class="total">Tong cong: {{TotalPrice}} đ</div>

    <p>
      <strong>Hinh thuc thanh toan:</strong> {{PaymentMethodLabel}}<br />
      <strong>Trang thai thanh toan:</strong>
      <span class="payment-badge {{PaymentStatusClass}}">{{PaymentStatusLabel}}</span>
    </p>

    <div class="footer">
      Neu can ho tro, vui long lien he PetShop. Chuc ban va thu cung luon khoe manh.
    </div>
  </div>
</body>
</html>
